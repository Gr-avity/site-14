# Lobby balance display
scp-tickets-lobby-balance = Ticket Balance: {$balance} (x{$modifier})

# Job cost display in late-join
scp-tickets-job-cost = [Ticket Cost: {$cost}]

# Messages when spending tickets on role spawn
scp-tickets-spent = You have spent {$cost} tickets for the {$role} role. Remaining balance: {$balance}
scp-tickets-insufficient = You do not have enough tickets to play as {$role}! This role costs {$cost} tickets and you only have {$balance}.

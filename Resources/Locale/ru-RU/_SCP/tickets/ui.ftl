# Lobby balance display
scp-tickets-lobby-balance = Баланс билетов: {$balance} (x{$modifier})

# Messages when spending tickets on role spawn
scp-tickets-spent = Вы потратили {$cost} билетов на роль {$role}. Остаток баланса: {$balance}
scp-tickets-insufficient = У вас недостаточно билетов, чтобы играть за роль {$role}! Эта роль стоит {$cost} билетов, а у вас только {$balance}.
